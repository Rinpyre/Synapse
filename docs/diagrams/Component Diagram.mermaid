C4Context 
    title Synapse Component Diagram
    
    System_Boundary(synapseBoundary, "Synapse") {
        Container_Boundary(frontendBoundary, "Frontend") {
            Component(query, "Query Input", "React", "User interface for entering queries")
            Component(results, "Results Display", "React", "Displays results and insights from the AI service")
            Component(aichat, "AI Chat Interface", "React", "Chat interface for interacting with the AI service")
        }
        Container_Boundary(backendBoundary, "Backend") {
            Component(suggestionapi, "Suggestion API", "Laravel", "Handles suggesting tags when users are querying")
            Component(queryapi, "Query API", "Laravel", "Handles incoming queries, processes them and interacts with the AI service and database")
            Component(chatapi, "Chat API", "Laravel", "Handles chat interactions with the AI service")
        }
    }
    Boundary(invisible, "External systems") {
        System_Boundary(aiBoundary, "AI Service provider") {
            Component(aiService, "Ollama/LM Studio", "Custom AI Service (Node.js)", "Processes queries, generates responses with summaries and insights")
        }
        ContainerDb(database, "Database", "SQL Server", "Persists users, bookings, equipment, logs and audit data")
    }

    BiRel(suggestionapi, query, "Provides tag<br>suggestions to")
    Rel(query, queryapi, "Sends user queries to")
    Rel(queryapi, results, "Receives query<br>results from")
    BiRel(aichat, chatapi, "Sends chat messages<br>to and from")
    BiRel(database, queryapi, "Retrieves data for queries from")
    BiRel(queryapi, aiService, "Receives queries requests for<br>data from and sends results to")
    BiRel(chatapi, aiService, "Sends user chats for processing<br>and receives responses from")

    UpdateRelStyle(suggestionapi, query, $textColor="#f8fafc", $lineColor="#f97316", $arrowheadColor="#f97316", $offsetX="-35", $offsetY="-5")
    UpdateRelStyle(query, queryapi, $textColor="#f8fafc", $lineColor="#f97316", $offsetX="-90", $offsetY="0")
    UpdateRelStyle(queryapi, results, $textColor="#f8fafc", $lineColor="#f97316", $offsetX="-45", $offsetY="0")
    UpdateRelStyle(aichat, chatapi, $textColor="#f8fafc", $lineColor="#f97316", $offsetX="-55", $offsetY="0")
    UpdateRelStyle(database, queryapi, $textColor="#f8fafc", $lineColor="#f97316", $offsetX="-70", $offsetY="0")
    UpdateRelStyle(queryapi, aiService, $textColor="#f8fafc", $lineColor="#f97316", $offsetX="-80", $offsetY="0")
    UpdateRelStyle(chatapi, aiService, $textColor="#f8fafc", $lineColor="#f97316", $offsetX="-150", $offsetY="0")

    UpdateElementStyle(suggestionapi, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")
    UpdateElementStyle(query, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")
    UpdateElementStyle(results, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")
    UpdateElementStyle(aichat, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")
    UpdateElementStyle(queryapi, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")
    UpdateElementStyle(chatapi, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")
    UpdateElementStyle(aiService, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")
    UpdateElementStyle(database, $bgColor="#0f172a", $borderColor="#475569", $textColor="#f8fafc")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="2")